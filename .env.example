# Gemini API Key（在 Google AI Studio 获取：https://aistudio.google.com/）
GOOGLE_API_KEY=your_google_api_key_here

# 代理服务器端口（默认 8787）
PORT=8787

# 代理鉴权 Key（Cursor 填写这个，任意字符串）
PROXY_API_KEY=sk-cursor-proxy-key

# 默认 Gemini 模型
DEFAULT_MODEL=gemini-2.5-pro-preview-03-25

# ================================
# 第三方代理配置 (CC Switch 兼容)
# ================================
# 如果在此处配置了外部代理，特定模型（如带 claude 的模型）将会
# 自动转发给该代理，而不是本地的 Antigravity 免费模型。
EXTERNAL_ANTHROPIC_BASE_URL="https://api.anthropic.com"
EXTERNAL_ANTHROPIC_API_KEY=""
